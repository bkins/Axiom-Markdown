root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion

# The canonical leading-comma/column conventions are documented in AGENTS.md.
# Default formatter output is not a substitute for the standards source check.
