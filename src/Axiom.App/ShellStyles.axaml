<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.toolbar-icon">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="5" />
  </Style>
  <Style Selector="Button.toolbar-icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.toolbar-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
  </Style>
  <Style Selector="Button.quiet-menu"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="3" /></Style>
  <Style Selector="Button.rounded-menu"><Setter Property="CornerRadius" Value="18" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.caption"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Width" Value="46" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" /></Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#B91C1C" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="TabItem"><Setter Property="CornerRadius" Value="6,6,0,0" /><Setter Property="Margin" Value="2,2,2,0" /><Setter Property="Padding" Value="7,2" /><Setter Property="MinHeight" Value="30" /></Style>
  <Style Selector="TabItem:selected"><Setter Property="BorderBrush" Value="#4F8EDC" /><Setter Property="BorderThickness" Value="0,0,0,2" /></Style>
  <Style Selector="TabItem:not(:selected)"><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" /><Setter Property="BorderThickness" Value="1,1,1,2" /></Style>
  <Style Selector="TreeViewItem"><Setter Property="MinHeight" Value="30" /></Style>
</Styles>
