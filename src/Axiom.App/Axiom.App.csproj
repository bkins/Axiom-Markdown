<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Axiom.Markdown</AssemblyName>
    <ApplicationIcon>Assets/Axiom.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Include="Assets/Terminal/THIRD-PARTY-NOTICES.txt" Link="ThirdPartyNotices/Terminal.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets/Mermaid/THIRD-PARTY-NOTICES.txt" Link="ThirdPartyNotices/Mermaid.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../Axiom.Core/Axiom.Core.csproj" />
    <ProjectReference Include="../Axiom.Infrastructure/Axiom.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive;compile;runtime" />
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <None Include="$(PkgMicrosoft_Web_WebView2)/LICENSE.txt" Link="ThirdPartyNotices/Microsoft.Web.WebView2.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
